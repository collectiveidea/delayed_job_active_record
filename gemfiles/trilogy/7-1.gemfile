# frozen_string_literal: true

source "https://rubygems.org"

gem "rake"

group :test do
  platforms :ruby, :mswin, :mingw do
    gem "trilogy", "~> 2.4"
  end

  gem "rspec", ">= 3"
  gem "simplecov", ">= 0.20.0", require: false
  gem "simplecov-lcov", ">= 0.8", require: false

  gem "activerecord", "~> 7.1.0"
end

gemspec path: "../../"
